# Apple Developer Credentials for code signing and notarization
# Copy this file to 'build_credentials' and fill in your actual values
# DO NOT commit build_credentials to version control!

# Your Apple Developer Team ID (found at developer.apple.com/account)
TEAM_ID="YOUR_TEAM_ID"

# Your Apple ID email address
APPLE_ID="your.email@example.com"

# App-specific password for notarization (create at appleid.apple.com under Security)
APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Optional: Specify Developer ID certificate name if you have multiple
# DEVELOPER_ID="Developer ID Application: Your Name (TEAM_ID)"
